# Dependencies
node_modules/
backend/node_modules/

# Environment files - Ignore ALL .env files EXCEPT .env.example
.env
.env.local
.env.development
.env.production
.env.test
.env.*
!.env.example

# Backend .env files
backend/.env
backend/.env.*
!backend/.env.example

# Logs
*.log
backend/*.log

# OS files
.DS_Store
backend/.DS_Store
Thumbs.db

# Build outputs
dist/
build/
coverage/
backend/dist/
backend/build/
backend/coverage/

# Uploads and temporary files
backend/src/uploads/*
!backend/src/uploads/.gitkeep

backend/src/logs/*
!backend/src/logs/.gitkeep

backend/src/temp/*
!backend/src/temp/.gitkeep

backend/src/cache/*
!backend/src/cache/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo