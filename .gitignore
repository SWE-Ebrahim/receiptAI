node_modules/
backend/node_modules/

# Environment files - Ignore ALL .env files EXCEPT .env.example
.env
.env.local
.env.development
.env.production
.env.test
.env.*
!.env.example

# Backend .env files
backend/.env
backend/.env.local
backend/.env.development
backend/.env.production
backend/.env.test
